# ── Frontend Environment Variables ──────────────────────────────────
# Copy to .env.local and fill in values.
#
# These are SERVER-SIDE ONLY (no NEXT_PUBLIC_ prefix).
# The browser never sees these — it only calls /api/v1/* (same-origin).
# Next.js proxy forwards those to BACKEND_API_ORIGIN.

# Spring Boot backend origin (server-side only, never exposed to browser)
# Local:      http://localhost:8080
# Docker:     http://backend:8080
# Production: https://api.hmnaturals.vn  (or your internal service URL)
BACKEND_API_ORIGIN=http://localhost:8080

# Proxy settings
PROXY_TIMEOUT_MS=10000
PROXY_MAX_BODY_BYTES=1048576
# File 5 MiB plus multipart overhead. Verify deployment host limits before release.
PROXY_MAX_MEDIA_BODY_BYTES=6291456
