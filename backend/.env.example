# ── Backend Environment Variables ───────────────────────────────────
# Copy to .env and fill in values.

SPRING_PROFILES_ACTIVE=local
# Production: set SPRING_PROFILES_ACTIVE=prod. Never use local/test in production.

# Server
SERVER_PORT=8080

# CORS — comma-separated origins allowed to call the API
# Local:      http://localhost:3000
# Production: https://hmnaturals.vn,https://www.hmnaturals.vn
APP_SECURITY_ALLOWED_ORIGINS=http://localhost:3000
# Production: replace with the explicit HTTPS frontend origins.

# Database
DB_CONNECTION=postgresql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=oil_shop
DB_USERNAME=postgres
DB_PASSWORD=change_me
# prod defaults to verify-full; mount the CA certificate required by PostgreSQL.
# disable is only for the isolated local release rehearsal.
DB_SSL_MODE=verify-full
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# Session cookie — set false for local HTTP dev, true for production HTTPS
SESSION_COOKIE_SECURE=true

# Used only with the bootstrap-admin profile. Do not commit real values.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Thumbnail upload — backend only; configure an existing public media bucket.
# Never use NEXT_PUBLIC_ variables for these credentials.
SUPABASE_URL=
SUPABASE_MEDIA_BUCKET=
SUPABASE_SERVICE_ROLE_KEY=

# Google Sheets mirror — backend only. Disabled by default; outbox still records mutations.
GOOGLE_SHEETS_SYNC_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=
# Mount a trusted service-account JSON outside the repository, readable only by the backend.
GOOGLE_SHEETS_CREDENTIALS_PATH=
GOOGLE_SHEETS_POLL_DELAY_MS=5000

# R2 upload (backend only); use a custom public domain for production.
MEDIA_PROVIDER=supabase
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
