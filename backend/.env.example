# ── Backend Environment Variables ───────────────────────────────────
# Copy to .env and fill in values.

SPRING_PROFILES_ACTIVE=local

# Server
SERVER_PORT=8080

# CORS — comma-separated origins allowed to call the API
# Local:      http://localhost:3000
# Production: https://hmnaturals.vn,https://www.hmnaturals.vn
APP_SECURITY_ALLOWED_ORIGINS=http://localhost:3000

# Database
DB_CONNECTION=postgresql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=oil_shop
DB_USERNAME=postgres
DB_PASSWORD=change_me

# Session cookie — set false for local HTTP dev, true for production HTTPS
SESSION_COOKIE_SECURE=true

# Used only with the bootstrap-admin profile. Do not commit real values.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Thumbnail upload — backend only; configure an existing public media bucket.
# Never use NEXT_PUBLIC_ variables for these credentials.
SUPABASE_URL=
SUPABASE_MEDIA_BUCKET=
SUPABASE_SERVICE_ROLE_KEY=
